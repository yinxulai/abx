#!/bin/sh
#
# abx commit-msg hook -- enforces the standard template (see .gitmessage).
# Installed via `git config core.hooksPath .githooks` (run by `pnpm install`).
#
# Bypass a single commit with:  git commit --no-verify
#
root="$(git rev-parse --show-toplevel)"
exec node "$root/packages/toolkit/scripts/check-commit-msg.mjs" "$1"
