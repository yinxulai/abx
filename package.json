{
  "name": "abx",
  "private": true,
  "version": "0.1.0",
  "license": "UNLICENSED",
  "author": "AlainClaw <yinxulai@hotmail.com>",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "release:mac": "pnpm build && pnpm --filter @abx/app run package:mac",
    "release:linux": "pnpm build && pnpm --filter @abx/app run package:linux",
    "lint": "node packages/toolkit/scripts/lint.mjs",
    "test": "node packages/toolkit/scripts/test.mjs",
    "test:coverage": "node packages/toolkit/scripts/test.mjs --coverage",
    "typecheck": "node packages/toolkit/scripts/typecheck.mjs",
    "commit:check": "node packages/toolkit/scripts/check-commit-msg.mjs",
    "prepare": "git config core.hooksPath .githooks && git config commit.template .gitmessage",
    "version:set": "node packages/toolkit/scripts/version.mjs",
    "version:check": "node packages/toolkit/scripts/version.mjs --check"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.71.2",
    "@typescript-eslint/utils": "^8.71.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@yinxulai/eslint-plugin-peculiar": "^1.0.6",
    "electron": "^44.7.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "turbo": "^2.11.7",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
